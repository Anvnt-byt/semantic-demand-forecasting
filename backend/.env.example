# Configuración de Entorno
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Base de Datos Interna (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pos_analytics

# Seguridad y Licencias SaaS (Local / Offline)
LICENSE_SECRET=techconnect-pos-secret-key-2026
API_KEY=

# Configuración de Conexión POS Cliente (Modo Solo Lectura - Opcional)
POS_DB_TYPE=mysql
POS_DB_HOST=localhost
POS_DB_PORT=3306
POS_DB_USER=pos_readonly
POS_DB_PASSWORD=pos_secure_password
POS_DB_NAME=pos_store_db
